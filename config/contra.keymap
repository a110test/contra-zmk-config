#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>

#define DEF         0
#define LWR         1
#define RSE         2
#define ADJ         3
#define WIN         4

&lt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mmv {
    time-to-max-speed-ms = <1000>;
};

&msc {
    time-to-max-speed-ms = <600>;
};

// rgb,SPI
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>;
            low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";


	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		label = "WS2812";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <10>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};

/ {
	chosen {
		zmk,underglow = &led_strip;
	};
};

/ {
    behaviors {
        mt_h: mod_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap H";
        };
        lt_h: layer_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap H";
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label= "DEF";
            bindings = <
&kp RBKT   &kp Q  &kp W          &kp E         &kp R          &kp T          &kp Y        &kp U            &kp I         &kp O          &kp P      &kp LBKT
&kp GRAVE  &kp A  &mt_h LGUI S   &mt_h LALT D  &mt_h LCTRL F  &kp G          &kp H        &mt_h RCTRL J    &mt_h RALT K  &mt_h RGUI L   &kp SEMI   &kp SQT
&kp BSLH   &kp Z  &kp X          &kp C         &kp V          &kp B          &kp N        &kp M            &kp COMMA     &kp DOT        &kp FSLH   &kp PIPE
&none      &none  &lt WIN EQUAL  &lt RSE TAB   &mt LSHFT SPC  &lt LWR ENTER  &lt LWR ESC  &mt RSHFT BSPC   &lt RSE DEL   &lt WIN MINUS  &none      &none
            >;
        };

        lower_layer {
            label= "LWR";
            bindings = <
&trans     &kp F1    &kp F2         &kp F3           &kp F4            &kp F5     &kp F6     &kp F7            &kp F8            &kp F9           &kp F10   &kp F11
&trans     &kp EXCL  &mt_h LGUI AT  &mt_h LALT HASH  &mt_h LCTRL DLLR  &kp PRCNT  &kp CARET  &mt_h RCTRL AMPS  &mt_h RALT ASTRK  &mt_h RGUI LPAR  &kp RPAR  &kp F12
&kp EQUAL  &kp N1    &kp N2         &kp N3           &kp N4            &kp N5     &kp N6     &kp N7            &kp N8            &kp N9           &kp N0    &kp MINUS
&trans     &trans    &trans         &mo ADJ          &trans            &trans     &trans    &trans             &mo ADJ           &trans           &trans    &trans
            >;
        };

        raise_layer {
            label= "RSE";
            bindings = <
&kp KP_NLCK  &kp KP_MULTIPLY  &kp KP_N7         &kp KP_N8         &kp KP_N9          &kp KP_PLUS   &kp CAPS  &kp HOME  &kp PSCRN        &kp PG_UP  &kp PIPE    &kp UNDER
&kp TAB      &kp KP_DIVIDE    &mt_h LGUI KP_N4  &mt_h LALT KP_N5  &mt_h LCTRL KP_N6  &kp KP_MINUS  &kp LEFT  &kp DOWN  &kp UP           &kp RIGHT  &kp INSERT  &kp RET
&trans       &kp KP_N0        &kp KP_N1         &kp KP_N2         &kp KP_N3          &kp KP_DOT    &kp SLCK  &kp END   &kp PAUSE_BREAK  &kp PG_DN  &kp BSLH    &kp BSPC
&trans       &trans           &trans            &trans            &trans             &mo ADJ       &mo ADJ   &trans    &trans           &trans     &trans      &trans
            >;
        };

        adjust_layer {
            label= "ADJ";
            bindings = <
&none       &bootloader   &out OUT_TOG  &sys_reset    &ext_power EP_OFF  &soft_off     &ext_power EP_TOG  &rgb_ug RGB_TOG   &rgb_ug RGB_BRI           &rgb_ug RGB_BRD            &rgb_ug RGB_EFF           &rgb_ug RGB_EFR
&none       &none         &kp LGUI      &kp LALT      &kp LCTRL          &none         &none            &mmv MOVE_LEFT      &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_UP    &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4  &none            &msc SCRL_LEFT      &mmv MOVE_DOWN  &msc SCRL_RIGHT  &msc SCRL_DOWN  &none
&trans      &trans        &trans        &trans        &trans             &trans        &mkp MB1         &mkp MB3            &mkp MB2        &trans           &trans          &trans
            >;
        };

        win_layer {
            label= "WIN";
            bindings = <
&trans  &kp LG(LC(LS(N1)))  &kp LG(LC(LS(N2)))  &kp LG(LC(LS(N3)))  &kp LG(LC(LS(N4)))  &none       &none       &none       &kp LG(L)   &kp K_MUTE  &kp K_VOL_UP  &none
&trans  &kp LG(LS(N1))      &kp LG(LS(N2))      &kp LG(LS(N3))      &kp LG(LS(N4))      &none       &none       &kp RCTRL   &kp RALT    &kp RGUI    &kp K_VOL_DN  &kp RET
&trans  &kp LG(N1)          &kp LG(N2)          &kp LG(N3)          &kp LG(N4)          &kp LG(N5)  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)    &kp LG(GRAVE)
&trans  &trans              &trans              &trans              &trans              &trans      &trans      &trans      &trans      &trans      &trans        &trans
            >;
        };
    };
};
